<?xml version="1.0" encoding="UTF-8"?>
<extensions xmlns="http://maven.apache.org/EXTENSIONS/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/EXTENSIONS/1.2.0 https://maven.apache.org/xsd/core-extensions-1.2.0.xsd">

  <!-- mvn-lens: JFR-based Maven build profiler used to monitor the Embabel Agent builds.
       https://github.com/mvn-perf/mvn-lens

       Every Maven invocation loads it and writes a self-contained HTML dashboard to
       target/mvnlens/report.html (relative to the execution root) when the session ends.
       Pass -Dmvnlens.disabled=true to switch it off for one invocation.

       Only SNAPSHOTs are published so far, to the Maven Central snapshot repository
       (https://central.sonatype.com/repository/maven-snapshots/). Core extensions are
       resolved before the project POM is read, so that repository cannot be declared in
       pom.xml for this artifact: .mvn/pom.xml pre-resolves it into the local repository
       instead. See .mvn/pom.xml and .github/workflows/maven.yml. -->
  <extension>
    <groupId>io.github.mvn-perf</groupId>
    <artifactId>mvn-lens-extension</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </extension>

</extensions>
